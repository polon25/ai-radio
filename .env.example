# --- Secrets ---
OPENROUTER_API_KEY=

# Icecast source password (must match <source-password> in icecast.xml)
ICECAST_PASSWORD=

# --- Local paths ---
# Root folder containing your music library (scanned by scanner.py)
MUSIC_FOLDER=./music

# --- Station selection ---
# Which entry from stations.json radio.liq runs, when started by hand (one
# liquidsoap process per station). Leave it unset with the systemd units:
# they set it per station, and a value here would override theirs.
# STATION_ID=ciezki_mlot

# --- Icecast connection ---
ICECAST_HOST=127.0.0.1
ICECAST_PORT=8000
# Optional: defaults to "/<STATION_ID>" if left unset (and like STATION_ID,
# a value here applies to every station)
ICECAST_MOUNT=

# --- Optional ---
# Sent as the HTTP-Referer header to OpenRouter (used for their leaderboard/rate limiting)
OPENROUTER_SITE_URL=https://github.com/your-username/your-project
# Seconds to wait for an OpenRouter response before giving up and falling back
OPENROUTER_TIMEOUT=60
# The same for background work (classifying artists, filling in track info)
OPENROUTER_BACKGROUND_TIMEOUT=180
# Model to use; openrouter/free picks some free model per request
OPENROUTER_MODEL=openrouter/free
# Tries per request before falling back to a random pick and fallback_script
OPENROUTER_ATTEMPTS=3
# Days of daily log files to keep (logs/ and stations/<id>/logs/)
LOG_RETENTION_DAYS=7
# Minimum level written to the station logs and stdout (DEBUG, INFO, WARNING, ...)
LOG_LEVEL=INFO
# Loudness (LUFS) DJ intros and news are raised to (ends up ~1.5-2 LU lower after limiting)
SPEECH_LOUDNESS_LUFS=-10
# Loudness (LUFS) songs are evened out to
MUSIC_LOUDNESS_LUFS=-13
# Prepare the next block once less than this many seconds of music are queued
BLOCK_LEAD_TIME=120
# Hours between background library rescans (0: only at startup)
SCAN_INTERVAL_HOURS=2

# --- Web page (web_server.py) ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_TITLE=AI Radio
# Streams' base URL for listeners; by default the page's host name with ICECAST_PORT
ICECAST_PUBLIC_URL=
