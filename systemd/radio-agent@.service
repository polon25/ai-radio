# The project directory and User below are filled in on install;
# see README, "Running at boot".
[Unit]
Description=AI Radio - DJ agent loop (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=radio
WorkingDirectory=/opt/ai-radio
EnvironmentFile=/opt/ai-radio/.env
Environment=STATION_ID=%i
ExecStart=/opt/ai-radio/venv/bin/python -u /opt/ai-radio/dj_agent.py %i --loop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
