# The project directory and User below are filled in on install;
# see README, "Running at boot".
[Unit]
Description=AI Radio - Liquidsoap player (%i)
After=network.target icecast2.service
Wants=icecast2.service

[Service]
Type=simple
User=radio
WorkingDirectory=/opt/ai-radio
EnvironmentFile=/opt/ai-radio/.env
Environment=STATION_ID=%i
ExecStart=/usr/bin/liquidsoap /opt/ai-radio/radio.liq
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
