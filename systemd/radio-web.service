# The project directory and User below are filled in on install;
# see README, "Running at boot".
[Unit]
Description=AI Radio - web page
After=network-online.target icecast2.service
Wants=network-online.target

[Service]
Type=simple
User=radio
WorkingDirectory=/opt/ai-radio
EnvironmentFile=/opt/ai-radio/.env
ExecStart=/opt/ai-radio/venv/bin/python -u /opt/ai-radio/web_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
