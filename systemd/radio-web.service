[Unit]
Description=AI Radio - web page
After=network-online.target icecast2.service
Wants=network-online.target

[Service]
Type=simple
User=polonius
WorkingDirectory=/home/polonius/Programy/Radio
EnvironmentFile=/home/polonius/Programy/Radio/.env
ExecStart=/home/polonius/Programy/Radio/venv/bin/python -u /home/polonius/Programy/Radio/web_server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
