{
  "example_station": {
    "name": "Example FM",
    "description": "A short description of the station's theme/vibe — steers both artist selection and the DJ script",
    "voice": "en-US-GuyNeural",
    "folder_filter": "%/some-genre-folder/%",
    "songs_per_block": 3,
    "use_ai_roster": true,
    "artist_cooldown_fraction": 0.1,
    "min_track_seconds": 90,
    "fallback_script": "Coming up next, some great music on our station.",
    "roster_prompt": "You are building the permanent artist roster for the radio station \"{station_name}\", described as: \"{description}\".\nHere is the full pool of artists found in the music library:\n{artists_list}\n\nYour task: select ALL artists from the list above that fit this station's style/vibe. Be inclusive of anything that reasonably fits the genre, but exclude anything clearly off-theme.\n\nYou MUST respond strictly in valid JSON format with no markdown formatting around it, structured like this:\n{{\n  \"selected_indices\": [1, 5, 12]\n}}",
    "prompt": "You are an expert DJ for the radio station \"{station_name}\", described as: \"{description}\".\nHere is a pool of available musical artists from the library:\n{artists_list}\n\nYour task:\n1. Select EXACTLY {song_count} artists from the list above that best fit the station's style/vibe. Ignore any artists that don't fit.\n2. Write a short, energetic DJ intro script introducing these {song_count} chosen artists/bands. Always refer to the station by its exact name, \"{station_name}\" — never invent a different name. Do not use emojis, asterisks, or hashtags.\n\nYou MUST respond strictly in valid JSON format with no markdown formatting around it, structured like this:\n{{\n  \"selected_indices\": [1, 5, 12],\n  \"dj_script\": \"Your generated intro text here...\"\n}}"
  },
  "another_example_dedicated_folder": {
    "name": "Dedicated Folder FM",
    "description": "A station scoped to a folder that's already curated, so it skips AI artist filtering entirely",
    "voice": "en-US-GuyNeural",
    "folder_filter": ["%/Some Folder/%", "%/Another Folder/%"],
    "songs_per_block": 3,
    "use_ai_roster": false,
    "fallback_script": "Coming up next, some great music on our station.",
    "roster_prompt": "(unused while use_ai_roster is false, but keep the field so it's ready if you ever flip it on)",
    "prompt": "You are an expert DJ for the radio station \"{station_name}\", described as: \"{description}\".\nHere is a pool of available musical artists from the library:\n{artists_list}\n\nYour task:\n1. Select EXACTLY {song_count} artists from the list above that best fit the station's style/vibe. Ignore any artists that don't fit.\n2. Write a short, energetic DJ intro script introducing these {song_count} chosen artists/bands. Always refer to the station by its exact name, \"{station_name}\" — never invent a different name. Do not use emojis, asterisks, or hashtags.\n\nYou MUST respond strictly in valid JSON format with no markdown formatting around it, structured like this:\n{{\n  \"selected_indices\": [1, 5, 12],\n  \"dj_script\": \"Your generated intro text here...\"\n}}"
  }
}
