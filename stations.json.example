{
  "example_station": {
    "name": "Example FM",
    "description": "A short description of the station's theme/vibe — steers both artist selection and the DJ script",
    "genre": "Rock",
    "url": "https://example.com",
    "voice": "en-US-GuyNeural",
    "folder_filter": "%/some-genre-folder/%",
    "songs_per_block": 3,
    "use_ai_roster": true,
    "artist_cooldown_fraction": 0.1,
    "min_track_seconds": 90,
    "track_cooldown_hours": 24,
    "fallback_script": "Coming up next, some great music on our station.",
    "roster_prompt": "You are building the permanent artist roster for the radio station \"{station_name}\", described as: \"{description}\".\nHere is the full pool of artists found in the music library:\n{artists_list}\n\nEach artist is listed with example track titles and the library folder they're in.\n\nYour task: select the artists from the list above that clearly belong to this station's theme. Be strict: judging by the name, the example titles and the folder, include an artist only if their music is squarely what this station is about. Exclude neighbouring genres that merely share an era, a mood or instruments with it, and when unsure, exclude. Selecting only a few, or none, is fine.\n\nYou MUST respond strictly in valid JSON format with no markdown formatting around it, structured like this:\n{{\n  \"selected_indices\": [1, 5, 12]\n}}",
    "prompt": "You are an expert DJ for the radio station \"{station_name}\", described as: \"{description}\".\nHere is a pool of available musical artists from the library:\n{artists_list}\n\nYour task:\n1. Select EXACTLY {song_count} artists from the list above that best fit the station's style/vibe. Ignore any artists that don't fit.\n2. Write a short, energetic DJ intro script introducing these {song_count} chosen artists/bands. Always refer to the station by its exact name, \"{station_name}\" — never invent a different name. Do not use emojis, asterisks, or hashtags.\n\nYou MUST respond strictly in valid JSON format with no markdown formatting around it, structured like this:\n{{\n  \"selected_indices\": [1, 5, 12],\n  \"dj_script\": \"Your generated intro text here...\"\n}}",
    "news": {
      "sources": [
        "https://www.example-news-site.com",
        "https://rss.nytimes.com/services/xml/rss/nyt/World.xml"
      ],
      "count": 4,
      "topics": [
        "national politics",
        "world news",
        "economy"
      ],
      "story_minutes": 2,
      "max_minutes": 15,
      "models": [
        "nvidia/nemotron-3-ultra-550b-a55b:free",
        "google/gemma-4-31b-it:free"
      ],
      "title": "News",
      "intro": "It's {hour}:00 on {station_name}. In this news segment: {topics}.",
      "outro": "That's all the news for now. Back to the music."
    }
  },
  "another_example_dedicated_folder": {
    "name": "Dedicated Folder FM",
    "description": "A station scoped to a folder that's already curated, so it skips AI artist filtering entirely",
    "genre": "Various",
